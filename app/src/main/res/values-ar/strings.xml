    <string name="privacy_title">سياسة الخصوصية</string>
    <string name="privacy_updated">آخر تحديث: أكتوبر 2026</string>
    <string-array name="privacy_titles">
        <item>الخلاصة</item>
        <item>ما يُخزَّن على جهازك</item>
        <item>استخدام الإنترنت</item>
        <item>الأذونات ولماذا نطلبها</item>
        <item>الميزات الذكية</item>
